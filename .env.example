# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Hardcoded API key required in the 'X-API-Key' header for extraction endpoints.
API_KEY=snmflix-secret-production-key-2026

# CORS Allowed Origins (comma-separated or '*' for all origins)
CORS_ORIGINS=*

# Extraction Limits & Concurrency
MAX_CONCURRENT_EXTRACTIONS=5
EXTRACTION_TIMEOUT_SECONDS=20
MAX_FORMATS_RETURNED=100

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# Maximum request body size in bytes (e.g. 65536 = 64KB)
MAX_REQUEST_BODY_SIZE=65536
