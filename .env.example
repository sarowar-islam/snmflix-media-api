# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Secret API key required in the 'X-API-Key' header for extraction endpoints.
# Leave blank during local testing to disable authentication, or set a secure token.
API_KEY=your-secret-api-key-here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://snmflix.vercel.app,http://localhost:3000,http://localhost:5173

# Extraction Limits & Concurrency
MAX_CONCURRENT_EXTRACTIONS=5
EXTRACTION_TIMEOUT_SECONDS=20
MAX_FORMATS_RETURNED=100

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# Maximum request body size in bytes (e.g. 65536 = 64KB)
MAX_REQUEST_BODY_SIZE=65536
